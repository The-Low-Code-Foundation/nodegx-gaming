ildren":[]}]}]}]},{"id":"rdSrc","type":"/Story/Source","parameters":{},"ports":[],"children":[]},{"id":"rdVarAt","type":"Variable2","parameters":{"name":"storyAt"},"ports":[],"children":[]},{"id":"rdVarCarry","type":"Variable2","parameters":{"name":"storyCarrying"},"ports":[],"children":[]},{"id":"rdStart","type":"Static Data","parameters":{"type":"json","json":"[]"},"ports":[],"children":[]},{"id":"rdFind","type":"JavaScriptFunction","parameters":{"functionScript":"const story = Inputs.story || [];\n// Where you are, or the beginning if you have not started. See the note above.\nconst at = String(Inputs.at || '') || String(Inputs.firstId || '');\n\nlet here = null;\nfor (let i = 0; i < story.length; i++) {\n  if (String((story[i] || {}).id) === at) {\n    here = story[i];\n    break;\n  }\n}\n\n// The id this seam SETTLED on, so nothing downstream has to re-derive the\n// fallback and disagree with it for a frame.\nOutputs.at = at;\n\nif (here === null) {\n  Outputs.found = false;\n  Outputs.title = '';\n  Outputs.text = '';\n  Outputs.choices = [];\n  Outputs.isEnding = false;\n  Outputs.missing = at;\n} else {\n  const choices = Array.isArray(here.choices) ? here.choices : [];\n  Outputs.found = true;\n  Outputs.title = String(here.title || '');\n  Outputs.text = String(here.text || '');\n  // A fresh array: Outputs publishes only on change.\n  Outputs.choices = choices.slice();\n  Outputs.isEnding = choices.length === 0;\n  Outputs.missing = '';\n}"},"ports":[{"name":"in-story","displayName":"story","plug":"input","type":"*","group":"Inputs","index":11},{"name":"in-at","displayName":"at","plug":"input","type":"*","group":"Inputs","index":12},{"name":"in-firstId","displayName":"firstId","plug":"input","type":"*","group":"Inputs","index":13},{"name":"out-at","displayName":"at","plug":"output","type":"*","group":"Outputs","index":14},{"name":"out-found","displayName":"found","plug":"output","type":"*","group":"Outputs","index":15},{"name":"out-title","displayName":"title","plug":"output","type":"*","group":"Outputs","index":16},{"name":"out-text","displayName":"text","plug":"output","type":"*","group":"Outputs","index":17},{"name":"out-choices","displayName":"choices","plug":"output","type":"*","group":"Outputs","index":18},{"name":"out-isEnding","displayName":"isEnding","plug":"output","type":"*","group":"Outputs","index":19},{"name":"out-missing","displayName":"missing","plug":"output","type":"*","group":"Outputs","index":20}],"children":[]},{"id":"rdScreen","type":"JavaScriptFunction","parameters":{"functionScript":"const choices = Inputs.choices || [];\nconst carrying = Inputs.carrying || [];\nconst at = String(Inputs.at || '');\nconst isEnding = Inputs.isEnding === true;\n\nconst have = {};\nfor (let i = 0; i < carrying.length; i++) {\n  const entry = carrying[i];\n  const name = typeof entry === 'string' ? entry : String((entry || {}).thing || '');\n  if (name !== '') have[name] = true;\n}\n\nconst rows = [];\nfor (let i = 0; i < choices.length; i++) {\n  const c = choices[i] || {};\n  const needs = String(c.requires || '');\n  // Absent, not greyed out. See the note above — this is the story, not the CSS.\n  if (needs !== '' && have[needs] !== true) continue;\n  rows.push({\n    id: at + '#' + i,\n    label: String(c.label || ''),\n    goto: String(c.goto || ''),\n    gives: String(c.gives || '')\n  });\n}\n\nOutputs.rows = rows;\nOutputs.carryCount = Object.keys(have).length;\n// 🔴 A passage that is not an ending and has nothing the reader can take. Every\n// choice it owns needs something they are not carrying, so the story stops here\n// and nothing in the data says it meant to.\nOutputs.stuck = !isEnding && rows.length === 0;"},"ports":[{"name":"in-choices","displayName":"choices","plug":"input","type":"*","group":"Inputs","index":11},{"name":"in-carrying","displayName":"carrying","plug":"input","type":"*","group":"Inputs","index":12},{"name":"in-at","displayName":"at","plug":"input","type":"*","group":"Inputs","index":13},{"name":"in-isEnding","displayName":"isEnding","plug":"input","type":"*","group":"Inputs","index":14},{"name":"out-rows","displayName":"rows","plug":"output","type":"*","group":"Outputs","index":15},{"name":"out-carryCount","displayName":"carryCount","plug":"output","type":"*","group":"Outputs","index":16},{"name":"out-stuck","displayName":"stuck","plug":"output","type":"*","group":"Outputs","index":17}],"children":[]},{"id":"rdCarry","type":"JavaScriptFunction","parameters":{"functionScript":"const carrying = Inputs.carrying || [];\nconst gift = String(Inputs.gift || '');\n\nconst out = [];\nconst seen = {};\nfor (let i = 0; i < carrying.length; i++) {\n  const entry = carrying[i];\n  const name = typeof entry === 'string' ? entry : String((entry || {}).thing || '');\n  if (name === '' || seen[name] === true) continue;\n  seen[name] = true;\n  out.push({ id: name, thing: name });\n}\n\nif (gift === '' || seen[gift] === true) {\n  Outputs.added = false;\n} else {\n  out.push({ id: gift, thing: gift });\n  Outputs.added = true;\n}\n\n// A fresh array every run: Outputs publishes only on change, and a mutated array\n// is the same object, so a reused one would never reach the graph.\nOutputs.carrying = out;","runOnChange-in-carrying":false,"runOnChange-in-gift":false},"ports":[{"name":"in-carrying","displayName":"carrying","plug":"input","type":"*","group":"Inputs","index":11},{"name":"in-gift","displayName":"gift","plug":"input","type":"*","group":"Inputs","index":12},{"name":"out-added","displayName":"added","plug":"output","type":"*","group":"Outputs","index":13},{"name":"out-carrying","displayName":"carrying","plug":"output","type":"*","group":"Outputs","index":14}],"children":[]},{"id":"rdFoundGate","type":"Condition","parameters":{"runOnChange-condition":false},"ports":[],"children":[]},{"id":"rdEndGate","type":"Condition","parameters":{"runOnChange-condition":false},"ports":[],"children":[]},{"id":"rdGiftGate","type":"Condition","parameters":{"runOnCha