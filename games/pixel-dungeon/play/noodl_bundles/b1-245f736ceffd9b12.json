.#...c#\\n#.###.#.##.#\\n#...#.#.#..#\\n#.#.#...#..#\\n#.#...#.c..#\\n#.#.###..#.#\\n#c..E....>.#\\n############\"\n  },\n  {\n    \"name\": \"Crossfire\",\n    \"grid\": \"############\\n#@..c#....E#\\n#.##.#.###.#\\n#..#...#c..#\\n#c.#.#.#.#.#\\n#..#.#...#.#\\n#.##.###.#.#\\n#E...c...>.#\\n############\"\n  },\n  {\n    \"name\": \"The long way\",\n    \"grid\": \"############\\n#@.#.......#\\n#..#.#####.#\\n##.#.#c..#.#\\n#..#.#.#.#c#\\n#.##.#.#.#.#\\n#....#.#.#.#\\n#.c..E.#.>.#\\n############\"\n  },\n  {\n    \"name\": \"Last light\",\n    \"grid\": \"############\\n#@..c....E.#\\n#.#..##..#.#\\n#.#.c..#.#c#\\n#....#.....#\\n#c##...##..#\\n#..#.E.#.#.#\\n#..c....>.E#\\n############\"\n  }\n]"},"ports":[],"children":[]},{"id":"plLevel","type":"Counter","parameters":{"startValue":1,"limitsMin":1,"limitsMax":5,"limitsEnabled":true},"ports":[],"children":[]},{"id":"plCoins","type":"Counter","parameters":{"startValue":0},"ports":[],"children":[]},{"id":"plHearts","type":"Counter","parameters":{"startValue":3,"limitsMin":0,"limitsMax":3,"limitsEnabled":true},"ports":[],"children":[]},{"id":"plReloads","type":"Counter","parameters":{"startValue":0},"ports":[],"children":[]},{"id":"plPickLevel","type":"JavaScriptFunction","parameters":{"functionScript":"var levels = Inputs.levels || [];\nvar i = Math.max(1, Number(Inputs.index) || 1) - 1;\nvar lv = levels[i] || levels[0] || { name: '', grid: '' };\nvar grid = String(lv.grid || '');\nvar rows = grid.split('\\n');\nvar w = 0;\nfor (var r = 0; r < rows.length; r++) if (rows[r].length > w) w = rows[r].length;\n\nvar coins = [];\nvar enemies = [];\nvar start = { x: 1, y: 1 };\nvar exit = { x: 1, y: 1 };\nfor (var y = 0; y < rows.length; y++) {\n  for (var x = 0; x < rows[y].length; x++) {\n    var ch = rows[y].charAt(x);\n    if (ch === 'c') coins.push(x + ',' + y);\n    else if (ch === 'E') enemies.push(x + ',' + y);\n    else if (ch === '@') start = { x: x, y: y };\n    else if (ch === '>') exit = { x: x, y: y };\n  }\n}\n\nOutputs.grid = grid;\nOutputs.width = w;\nOutputs.height = rows.length;\nOutputs.roomName = String(lv.name || '');\nOutputs.startX = start.x;\nOutputs.startY = start.y;\nOutputs.exitX = exit.x;\nOutputs.exitY = exit.y;\n// A fresh array every run: Outputs publishes only on change, and a mutated\n// array is the same object, so a reused one would never reach the graph.\nOutputs.coins = coins.slice();\nOutputs.enemies = enemies.slice();\nOutputs.levelCount = levels.length;\n\n// 🔴 READ THE NUDGE, or the port it is wired to does not exist.\n// A Function node's ports come from THIS SCRIPT — reading Inputs.reload is the\n// only thing that mints \"in-reload\". The graph wired a Counter to it and the\n// script never mentioned it, so the port was never registered and the real\n// exporter dropped the connection: the room could never restart. The render\n// harness hid it by lifting ports off connections, so it worked under\n// measurement and would not have worked in the product.\nOutputs.reload = Number(Inputs.reload) || 0;"},"ports":[{"name":"in-levels","displayName":"levels","plug":"input","type":"*","group":"Inputs","index":11},{"name":"in-index","displayName":"index","plug":"input","type":"*","group":"Inputs","index":12},{"name":"in-reload","displayName":"reload","plug":"input","type":"*","group":"Inputs","index":13},{"name":"out-grid","displayName":"grid","plug":"output","type":"*","group":"Outputs","index":14},{"name":"out-width","displayName":"width","plug":"output","type":"*","group":"Outputs","index":15},{"name":"out-height","displayName":"height","plug":"output","type":"*","group":"Outputs","index":16},{"name":"out-roomName","displayName":"roomName","plug":"output","type":"*","group":"Outputs","index":17},{"name":"out-startX","displayName":"startX","plug":"output","type":"*","group":"Outputs","index":18},{"name":"out-startY","displayName":"startY","plug":"output","type":"*","group":"Outputs","index":19},{"name":"out-exitX","displayName":"exitX","plug":"output","type":"*","group":"Outputs","index":20},{"name":"out-exitY","displayName":"exitY","plug":"output","type":"*","group":"Outputs","index":21},{"name":"out-coins","displayName":"coins","plug":"output","type":"*","group":"Outputs","index":22},{"name":"out-enemies","displayName":"enemies","plug":"output","type":"*","group":"Outputs","index":23},{"name":"out-levelCount","displayName":"levelCount","plug":"output","type":"*","group":"Outputs","index":24},{"name":"out-reload","displayName":"reload","plug":"output","type":"*","group":"Outputs","index":25}],"children":[]},{"id":"plVarX","type":"Variable2","parameters":{"name":"playerX"},"ports":[],"children":[]},{"id":"plVarY","type":"Variable2","parameters":{"name":"playerY"},"ports":[],"children":[]},{"id":"plVarCoins","type":"Variable2","parameters":{"name":"coinsLeft"},"ports":[],"children":[]},{"id":"plVarEnemies","type":"Variable2","parameters":{"name":"enemyTiles"},"ports":[],"children":[]},{"id":"plLoadX","type":"Set Variable","parameters":{"name":"playerX"},"ports":[],"children":[]},{"id":"plLoadY","type":"Set Variable","parameters":{"name":"playerY"},"ports":[],"children":[]},{"id":"plLoadCoins","type":"Set Variable","parameters":{"name":"coinsLeft"},"ports":[],"children":[]},{"id":"plLoadEnemies","type":"Set Variable","parameters":{"name":"enemyTiles"},"ports":[],"children":[]},{"id":"plKeyUp","type":"keyboard-shortcuts.KeyboardShortcut","parameters":{"shortcut":"up, arrowup, w","allowRepeat":true,"preventDefault":true,"ignoreInTextFields":true},"ports":[],"children":[]},{"id":"plKeyDown","type":"keyboard-shortcuts.KeyboardShortcut","parameters":{"shortcut":"down, arrowdown, s","allowRepeat":true,"preventDefault":true,"ignoreInTextFields":true},"ports":[],"children":[]},{"id":"plKeyLeft","type":"keyboard-shortcuts.KeyboardShortcut","parameters":{"shortcut":"left, arrowleft, a","allowRepeat":true,"preventDefault":true,"ignoreInTextFields":true},"ports":[],"children":[]},{"id":"plKeyRight","type":"keyboard-shortcuts.KeyboardShortcut","parameters":{"shortcut":"right, arrowright, d","allowRepeat":true,"preventDefault":true,"ignoreInTextFields":true},"ports":[],"children":[]},{"id":"plMoveUp","type":"/Game/Move","parameters":{"dx":0,"dy":-1},"ports":[],"children":[]},{"id":"plMoveDown","type":"/Game/Move","parameters":{"dx":0,"dy":1},"ports":[],"children":[]},{"id":"plMoveLeft","type":"/Game/Move","parameters":{"dx":-1,"dy":0},"ports":[],"children":[]},{"id":"plMoveRight","type":"/Game/Move","parameters":{"dx":1,"dy":0},"ports":[],"children":[]},{"id":"plTakeCoin","type":"JavaScriptFunction","parameters":{"functionScript":"var coins = (Inputs.coins || []).slice();\nvar key = Number(Inputs.x) + ',' + Number(Inputs.y);\nvar at = coins.indexOf(key);\nif (at === -1) {\n  Outputs.taken = false;\n} else {\n  coins.splice(at, 1);\n  Outputs.taken = true;\n}\nOutputs.coins = coins;\nOutputs.left = coins.length;","runOnChange-in-coins":false,"runOnChange-in-x":false,"runOnChange-in-y":false},"ports":[{"name":"in-coins","displayName":"coins","plug":"input","type":"*","group":"Inputs","index":11},{"name":"in-x","displayName":"x","plug":"input","type":"*","group":"Inputs","index":12},{"name":"in-y","displayName":"y","plug":"input","type":"*","group":"Inputs","index":13},{"name":"out-taken","displayName":"taken","plug":"output","type":"*","group":"Outputs","index":14},{"name":"out-coins","displayName":"coins","plug":"output","type":"*","group":"Outputs","index":15},{"name":"out-left","displayName":"left","plug":"output","type":"*","group":"Outputs","index":16}],"children":[]},{"id":"plCoinGate","type":"Condition","parameters":{"runOnChange-condition":false},"ports":[],"children":[]},{"id":"plSetCoins","type":"Set Variable","parameters":{"name":"coinsLeft"},"ports":[],"children":[]},{"id":"plAtExit","type":"Expression","parameters":{"expression":"x === ex && y === ey"},"ports":[],"children":[]},{"id":"plExitGate","type":"Condition","parameters":{"runOnChange-condition":false},"ports":[],"children":[]},{"id":"plIsLast","type":"Expression","parameters":{"expression":"lvl >= last"},"ports":[],"children":[]},{"id":"plWinGate","type":"Condition","parameters":{"runOnChange-condition":false},"ports":[],"children":[]},{"id":"plStepEnemies","type":"JavaScriptFunction","parameters":{"functionScript":"var rows = String(Inputs.grid || '').split('\\n');\nvar w = Number(Inputs.w) || 0;\nvar px = Number(Inputs.px);\nvar py = Number(Inputs.py);\n\nfunction wall(x, y) {\n  // Same NaN guard as Game/Move's: an un-loaded room makes every coordinate NaN.\n  if (!Number.isFinite(x) || !Number.isFinite(y)) return true;\n  if (x < 0 || y < 0 || x >= w || y >= rows.length) return true;\n  var ch = rows[y].charAt(x);\n  return ch === '#' || ch === '';\n}\n\nvar list = Inputs.enemies || [];\nvar out = [];\nvar claimed = {};\nvar hurt = false;\n\nfor (var i = 0; i < list.length; i++) {\n  var parts = String(list[i]).split(',');\n  var ex = Number(parts[0]);\n  var ey = Number(parts[1]);\n\n  // YOU CHARGED IT: it is already on your tile, because it will never step\n  // there itself. Costs a heart, and it is gone - which is what keeps a\n  // one-wide corridor passable instead of sealed by a body.\n  if (ex === px && ey === py) {\n    hurt = true;\n    continue;\n  }\n\n  var dx = px - ex;\n  var dy = py - ey;\n  var tries = [];\n  if (Math.abs(dx) >= Math.abs(dy)) {\n    if (dx !== 0) tries.push([ex + (dx > 0 ? 1 : -1), ey]);\n    if (dy !== 0) tries.push([ex, ey + (dy > 0 ? 1 : -1)]);\n  } else {\n    if (dy !== 0) tries.push([ex, ey + (dy > 0 ? 1 : -1)]);\n    if (dx !== 0) tries.push([ex + (dx > 0 ? 1 : -1), ey]);\n  }\n\n  var nx = ex;\n  var ny = ey;\n  for (var t = 0; t < tries.length; t++) {\n    var cx = tries[t][0];\n    var cy = tries[t][1];\n    if (wall(cx, cy)) continue;\n    if (claimed[cx + ',' + cy]) continue;\n    // IT REACHED YOU: an attack, and it HOLDS ITS GROUND. Never ending a turn\n    // on your tile is what makes the distance always at least one, so moving\n    // away always works.\n    if (cx === px && cy === py) {\n      hurt = true;\n      break;\n    }\n    nx = cx;\n    ny = cy;\n    break;\n  }\n  claimed[nx + ',' + ny] = true;\n  out.push(nx + ',' + ny);\n}\n\n// A fresh array, and one that CANNOT contain your own tile.\nOutputs.enemies = out;\nOutputs.hurt = hurt;","runOnChange-in-enemies":false,"runOnChange-in-grid":false,"runOnChange-in-w":false,"runOnChange-in-px":false,"runOnChange-in-py":false},"ports":[{"name":"in-grid","displayName":"grid","plug":"input","type":"*","group":"Inputs","index":11},{"name":"in-w","displayName":"w","plug":"input","type":"*","group":"Inputs","index":12},{"name":"in-px","displayName":"px","plug":"input","type":"*","group":"Inputs","index":13},{"name":"in-py","displayName":"py","plug":"input","type":"*","group":"Inputs","index":14},{"name":"in-enemies","displayName":"enemies","plug":"input","type":"*","group":"Inputs","index":15},{"name":"out-enemies","displayName":"enemies","plug":"output","type":"*","group":"Outputs","index":16},{"name":"out-hurt","displayName":"hurt","plug":"output","type":"*","group":"Outputs","index":17}],"children":[]},{"id":"plSetEnemies","type":"Set Variable","parameters":{"name":"enemyTiles"},"ports":[],"children":[]},{"id":"plHitGate","type":"Condition","parameters":{"runOnChange-condition":false},"ports":[],"children":[]},{"id":"plIsDead","type":"Expression","parameters":{"expression":"hearts <= 0"},"ports":[],"children":[]},{"id":"plDeathGate","type":"Condition","parameters":{"runOnChange-condition":false},"ports":[],"children":[]},{"id":"plBuildCells","type":"JavaScriptFunction","parameters":{"functionScript":"var rows = String(Inputs.grid || '').split('\\n');\n// The legend, as the page's own Static Data node wrote it. A kind with no row\n// falls back to the first, so an unknown kind draws as floor rather than as\n// nothing — an invisible tile is a hole in the board.\nvar palette = {};\nvar legend = Inputs.legend || [];\nfor (var p = 0; p < legend.length; p++) palette[String(legend[p].kind)] = legend[p];\nvar fallback = legend[0] || { ground: '', edge: '', ink: '' };\nvar w = Number(Inputs.w) || 0;\nvar px = Number(Inputs.px);\nvar py = Number(Inputs.py);\n\nvar coinAt = {};\nvar coins = Inputs.coins || [];\nfor (var i = 0; i < coins.length; i++) coinAt[String(coins[i])] = true;\n\nvar enemyAt = {};\nvar enemies = Inputs.enemies || [];\nfor (var j = 0; j < enemies.length; j++) enemyAt[String(enemies[j])] = true;\n\nvar out = [];\nfor (var y = 0; y < rows.length; y++) {\n  var cells = [];\n  for (var x = 0; x < w; x++) {\n    var ch = rows[y].charAt(x) || '#';\n    var kind = 'floor';\n    var glyph = '';\n    if (ch === '#') {\n      kind = 'wall';\n    } else if (x === px && y === py) {\n      kind = 'player';\n      glyph = '◆';\n    } else if (enemyAt[x + ',' + y]) {\n      kind = 'enemy';\n      glyph = '▲';\n    } else if (coinAt[x + ',' + y]) {\n      kind = 'coin';\n      glyph = '●';\n    } else if (ch === '>') {\n      kind = 'exit';\n      glyph = '▣';\n    }\n    var look = palette[kind] || fallback;\n    cells.push({\n      id: x + ',' + y,\n      kind: kind,\n      glyph: glyph,\n      ground: look.ground,\n      edge: look.edge,\n      ink: look.ink\n    });\n  }\n  out.push({ id: 'row' + y, cells: cells });\n}\nOutputs.rows = out;"},"ports":[{"name":"in-grid","displayName":"grid","plug":"input","type":"*","group":"Inputs","index":11},{"name":"in-legend","displayName":"legend","plug":"input","type":"*","group":"Inputs","index":12},{"name":"in-w","displayName":"w","plug":"input","type":"*","group":"Inputs","index":13},{"name":"in-px","displayName":"px","plug":"input","type":"*","group":"Inputs","index":14},{"name":"in-py","displayName":"py","plug":"input","type":"*","group":"Inputs","index":15},{"name":"in-coins","displayName":"coins","plug":"input","type":"*","group":"Inputs","index":16},{"name":"in-enemies","displayName":"enemies","plug":"input","type":"*","group":"Inputs","index":17},{"name":"out-rows","displayName":"rows","plug":"output","type":"*","group":"Outputs","index":18}],"children":[]},{"id":"plPalette","type":"Static Data","parameters":{"type":"json","json":"[\n  {\n    \"kind\": \"floor\",\n    \"ground\": \"var(--background)\",\n    \"edge\": \"var(--background)\",\n    \"ink\": \"var(--muted-foreground)\"\n  },\n  {\n    \"kind\": \"wall\",\n    \"ground\": \"var(--secondary)\",\n    \"edge\": \"var(--border-strong)\",\n    \"ink\": \"var(--secondary)\"\n  },\n  {\n    \"kind\": \"coin\",\n    \"ground\": \"var(--background)\",\n    \"edge\": \"var(--background)\",\n    \"ink\": \"var(--primary)\"\n  },\n  {\n    \"kind\": \"enemy\",\n    \"ground\": \"var(--background)\",\n    \"edge\": \"var(--destructive)\",\n    \"ink\": \"var(--destructive)\"\n  },\n  {\n    \"kind\": \"exit\",\n    \"ground\": \"var(--accent)\",\n    \"edge\": \"var(--accent-foreground)\",\n    \"ink\": \"var(--accent-foreground)\"\n  },\n  {\n    \"kind\": \"player\",\n    \"ground\": \"var(--background)\",\n    \"edge\": \"var(--primary)\",\n    \"ink\": \"var(--primary)\"\n  }\n]"},"ports":[],"children":[]},{"id":"plBannerStates","type":"States","parameters":{"states":"playing,cleared,died,won","values":"title,line,shown,tone","type-title":"string","type-line":"string","type-shown":"boolean","type-tone":"color","value-playing-title":"","value-playing-line":"","value-playing-shown":false,"value-playing-tone":"var(--foreground)","value-cleared-title":"Room cleared.","value-cleared-line":"The next one is busier. Keep moving.","value-cleared-shown":true,"value-cleared-tone":"var(--primary)","value-died-title":"They got you.","value-died-line":"You dropped your coins and the room starts again. Move to go on.","value-died-shown":true,"value-died-tone":"var(--destructive)","value-won-title":"Out, with all five behind you.","value-won-line":"That is the lot. Move to start another run.","value-won-shown":true,"value-won-tone":"var(--accent-foreground)","useTransition