id":"rdAgainBtn","type":"net.noodl.controls.button","parameters":{"label":"Another reading","backgroundColor":"var(--primary)","color":"var(--primary-foreground)","borderRadius":"var(--radius-full)","borderStyle":"none","paddingLeft":"var(--space-6)","paddingRight":"var(--space-6)","paddingTop":"var(--space-3)","paddingBottom":"var(--space-3)","fontSize":"var(--text-base)","fontWeight":"var(--font-semibold)","sizeMode":"contentSize","marginTop":"var(--space-2)"},"ports":[],"children":[]}]}]}]}]},{"id":"rdSpreads","type":"/Data/Spreads","parameters":{},"ports":[],"children":[]},{"id":"rdCards","type":"/Data/Cards","parameters":{},"ports":[],"children":[]},{"id":"rdVSpread","type":"Variable2","parameters":{"name":"readSpread"},"ports":[],"children":[]},{"id":"rdVStep","type":"Variable2","parameters":{"name":"readStep"},"ports":[],"children":[]},{"id":"rdVPhase","type":"Variable2","parameters":{"name":"readPhase"},"ports":[],"children":[]},{"id":"rdVCard","type":"Variable2","parameters":{"name":"readCard"},"ports":[],"children":[]},{"id":"rdVUp","type":"Variable2","parameters":{"name":"readUpsideDown"},"ports":[],"children":[]},{"id":"rdVDrawn","type":"Variable2","parameters":{"name":"readDrawn"},"ports":[],"children":[]},{"id":"rdVTotal","type":"Variable2","parameters":{"name":"readTotal"},"ports":[],"children":[]},{"id":"rdPhase","type":"States","parameters":{"states":"pick,show,done","values":"x","useTransitions":false},"ports":[],"children":[]},{"id":"rdPos","type":"JavaScriptFunction","parameters":{"functionScript":"const spreads = Inputs.spreads || [];\nconst s = spreads.find(x => x.id === Inputs.spreadId) || spreads[0];\nif (!s) return;\nconst total = s.positions.length;\nconst step = Math.min(Inputs.step || 0, total - 1);\nconst p = s.positions[step];\nconst drawn = Inputs.drawn || [];\nconst othersLeft = s.positions.some((q, i) => i !== step && !drawn.some(d => d.step === i));\nOutputs.spreadName = s.name;\nOutputs.posName = p.name;\nOutputs.posLead = p.lead;\nOutputs.total = total;\nOutputs.stepLabel = total > 1 && Inputs.phase !== 'done' ? 'Card ' + (step + 1) + ' of ' + total : '';\nOutputs.keepLabel = total === 1 ? 'Done' : (othersLeft ? 'Next card' : 'See the whole reading');\n"},"ports":[{"name":"in-spreads","displayName":"spreads","plug":"input","type":"*","group":"Inputs","index":11},{"name":"in-spreadId","displayName":"spreadId","plug":"input","type":"*","group":"Inputs","index":12},{"name":"in-step","displayName":"step","plug":"input","type":"*","group":"Inputs","index":13},{"name":"out-spreadName","displayName":"spreadName","plug":"output","type":"*","group":"Outputs","index":14},{"name":"out-posName","displayName":"posName","plug":"output","type":"*","group":"Outputs","index":15},{"name":"out-posLead","displayName":"posLead","plug":"output","type":"*","group":"Outputs","index":16},{"name":"out-total","displayName":"total","plug":"output","type":"*","group":"Outputs","index":17},{"name":"out-stepLabel","displayName":"stepLabel","plug":"output","type":"*","group":"Outputs","index":18},{"name":"out-keepLabel","displayName":"keepLabel","plug":"output","type":"*","group":"Outputs","index":19}],"children":[]},{"id":"rdCard","type":"JavaScriptFunction","parameters":{"functionScript":"const c = (Inputs.cards || []).find(x => x.id === Inputs.cardId);\nif (!c) return;\nconst down = !!Inputs.upsideDown;\nOutputs.src = 'cards/' + c.id + '.svg';\nOutputs.name = c.name;\nOutputs.keywords = Scripts.reading.keywordsFor(c, down);\nOutputs.text = down ? c.rev : c.up;\nOutputs.ask = down ? c.askRev : c.askUp;\nOutputs.reversed = down;\nOutputs.more = Scripts.reading.moreFor(c, down, 'm-');\n","uses":"reading.js"},"ports":[{"name":"in-cards","displayName":"cards","plug":"input","type":"*","group":"Inputs","index":11},{"name":"in-cardId","displayName":"cardId","plug":"input","type":"*","group":"Inputs","index":12},{"name":"in-upsideDown","displayName":"upsideDown","plug":"input","type":"*","group":"Inputs","index":13},{"name":"out-chip","displayName":"chip","plug":"output","type":"*","group":"Outputs","index":14},{"name":"out-name","displayName":"name","plug":"output","type":"*","group":"Outputs","index":15},{"name":"out-suitName","displayName":"suitName","plug":"output","type":"*","group":"Outputs","index":16},{"name":"out-keywords","displayName":"keywords","plug":"output","type":"*","group":"Outputs","index":17},{"name":"out-text","displayName":"text","plug":"output","type":"*","group":"Outputs","index":18},{"name":"out-ask","displayName":"ask","plug":"output","type":"*","group":"Outputs","index":19},{"name":"out-reversed","displayName":"reversed","plug":"output","type":"*","group":"Outputs","index":20}],"children":[]},{"id":"rdFlipLook","type":"Expression","parameters":{"expression":"upsideDown ? 'down' : 'up'"},"ports":[],"children":[]},{"id":"rdFlipStates","type":"States","parameters":{"states":"up,down","values":"upBg,upInk,downBg,downInk","useTransitions":false,"type-upBg":"color","type-upInk":"color","type-downBg":"color","type-downInk":"color","value-up-upBg":"var(--primary)","value-up-upInk":"var(--primary-foreground)","value-up-downBg":"transparent","value-up-downInk":"var(--foreground)","value-down-upBg":"transparent","value-down-upInk":"var(--foreground)","value-down-downBg":"var(--primary)","value-down-downInk":"var(--primary-foreground)"},"ports":[],"children":[]},{"id":"rdDraw","type":"JavaScriptFunction","parameters":{"functionScript":"const ids = [];\nfor (let i = 0; i < 22; i++) ids.push('major-' + String(i).padStart(2, '0'));\nfor (const s of ['wands', 'cups', 'swords', 'pentacles'])\n  for (let i = 1; i <= 14; i++) ids.push(s + '-' + String(i).padStart(2, '0'));\nconst step = Noodl.Variables.readStep || 0;\nconst others = (Noodl.Variables.readDrawn || []).filter(d => d.step !== step);\nconst used = others.map(d => d.cardId);\nconst left = ids.filter(id => used.indexOf(id) < 0);\nconst id = left[Math.floor(Math.random() * left.length)];\nconst down = Math.random() < 0.5;\n// Kept straight away, like a card picked by hand.\nconst drawn = others.concat([{ id: 'pos' + step, step: step, cardId: id, reversed: down }]);\ndrawn.sort((a, b) => a.step - b.step);\nNoodl.Variables.readDrawn = drawn;\nNoodl.Variables.readCard = id;\nNoodl.Variables.readUpsideDown = down;\nNoodl.Variables.readPhase = 'show';\n"},"ports":[],"children":[]},{"id":"rdKeep","type":"JavaScriptFunction","parameters":{"functionScript":"// The card is already kept (it was the moment it was picked). This only moves on.\n// A second tap (a double tap on a phone) arrives after we've moved on: nothing to do.\nif (Noodl.Variables.readPhase !== 'show') return;\nconst step = Noodl.Variables.readStep || 0;\nconst total = Noodl.Variables.readTotal || 1;\nconst drawn = Noodl.Variables.readDrawn || [];\n// The next empty place after this one, going round; none left means the reading is complete.\nlet next = -1;\nfor (let k = 1; k <= total; k++) {\n  const j = (step + k) % total;\n  if (!drawn.some(d => d.step === j)) { next = j; break; }\n}\nif (next < 0) {\n  Noodl.Variables.readPhase = 'done';\n} else {\n  Noodl.Variables.readStep = next;\n  Noodl.Variables.readCard = '';\n  Noodl.Variables.readUpsideDown = false;\n  Noodl.Variables.readPhase = 'pick';\n}\n"},"ports":[],"children":[]},{"id":"rdTopOfPage","type":"JavaScriptFunction","parameters":{"functionScript":"window.scrollTo(0, 0);\n"},"ports":[],"children":[]},{"id":"rdSummary","type":"JavaScriptFunction","parameters":{"functionScript":"const spreads = Inputs.spreads || [];\nconst s = spreads.find(x => x.id === Inputs.spreadId) || spreads[0];\nconst cards = Inputs.cards || [];\nOutputs.rows = (Inputs.drawn || []).slice().sort((a, b) => a.step - b.step).map(d => {\n  const c = cards.find(x => x.id === d.cardId) || {};\n  const p = (s && s.positions[d.step]) || {};\n  return {\n    id: d.id,\n    position: (d.step + 1) + '. ' + (p.name || ''),\n    name: d.reversed ? c.name + ', upside down' : c.name,\n    src: 'cards/' + d.cardId + '.svg',\n    turn: d.reversed ? 180 : 0,\n    keywords: Scripts.reading.keywordsFor(c, d.reversed),\n    text: d.reversed ? c.rev : c.up,\n    ask: d.reversed ? c.askRev : c.askUp\n  };\n});\n","uses":"reading.js"},"ports":[{"name":"in-spreads","displayName":"spreads","plug":"input","type":"*","group":"Inputs","index":11},{"name":"in-spreadId","displayName":"spreadId","plug":"input","type":"*","group":"Inputs","index":12},{"name":"in-cards","displayName":"cards","plug":"input","type":"*","group":"Inputs","index":13},{"name":"in-drawn","displayName":"drawn","plug":"input","type":"*","group":"Inputs","index":14},{"name":"out-rows","displayName":"rows","plug":"output","type":"*","group":"Outputs","index":15}],"children":[]},{"id":"rdGoHome","type":"RouterNavigate","parameters":{"target":"/Pages/Home"},"ports":[],"children":[]},{"id":"rdLay","type":"JavaScriptFunction","parameters":{"functionScript":"const spreads = Inputs.spreads || [];\nconst s = spreads.find(x => x.id === Inputs.spreadId) || spreads[0];\nif (!s) return;\nconst cards = Inputs.cards || [];\nconst drawn = Inputs.drawn || [];\nconst step = Inputs.step || 0;\nconst looking = Inputs.phase === 'show' && Inputs.card;\nconst RATIO = 1.7;\nlet x0 = Infinity, x1 = -Infinity, y0 = Infinity, y1 = -Infinity;\nfor (const p of s.positions) {\n  const hw = (p.turn ? RATIO : 1) / 2;\n  const hh = (p.turn ? 1 : RATIO) / 2;\n  x0 = Math.min(x0, (p.x || 0) - hw);\n  x1 = Math.max(x1, (p.x || 0) + hw);\n  y0 = Math.min(y0, (p.y || 0) - hh);\n  y1 = Math.max(y1, (p.y || 0) + hh);\n}\n// A card with another lying across it shows its number at the top, and the crossing card at its end, so both stay readable.\nconst crossed = (p) => !p.turn && s.positions.some(q => q.turn && q.x === p.x && q.y === p.y);\nfunction lay(maxW, maxH, biggest, live) {\n  const u = Math.min(maxW / (x1 - x0), maxH / (y1 - y0), biggest);\n  const w = Math.round(u);\n  const h = Math.round(u * RATIO);\n  const slots = s.positions.map((p, i) => {\n    const kept = drawn.find(d => d.step === i);\n    const here = live && i === step;\n    const cardId = here && looking ? Inputs.card : (kept ? kept.cardId : '');\n    const down = here && looking ? !!Inputs.upsideDown : !!(kept && kept.reversed);\n    const c = cards.find(x => x.id === cardId);\n    return {\n      id: 'place' + i,\n      index: i,\n      label: String(i + 1),\n      state: here ? (cardId ? 'herecard' : 'here') : (cardId ? 'filled' : 'empty'),\n      src: cardId ? 'cards/' + cardId + '.svg' : '',\n      name: c ? c.name : '',\n      w: w,\n      h: h,\n      left: Math.round(((p.x || 0) - x0) * u - w / 2),\n      top: Math.round(((p.y || 0) - y0) * u - h / 2),\n      turn: (p.turn || 0) + (down ? 180 : 0),\n      z: p.turn ? 2 : 1,\n      align: p.turn ? 'flex-end' : (crossed(p) ? 'flex-start' : 'center')\n    };\n  });\n  return { slots: slots, width: Math.round((x1 - x0) * u), height: Math.round((y1 - y0) * u) };\n}\nconst small = lay(300, 230, 64, Inputs.phase !== 'done');\nOutputs.slots = small.slots;\nOutputs.width = small.width;\nOutputs.height = small.height;\nconst big = lay(320, 470, 110, false);\nOutputs.fullSlots = big.slots;\nOutputs.fullWidth = big.width;\nOutputs.fullHeight = big.height;\n"},"ports":[],"children":[]},{"id":"rdSetTapped","type":"Set Variable","parameters":{"name":"readTapped","setWith":"number"},"ports":[],"children":[]},{"id":"rdGoTo","type":"JavaScriptFunction","parameters":{"functionScript":"const i = Noodl.Variables.readTapped || 0;\nconst kept = (Noodl.Variables.readDrawn || []).find(d => d.step === i);\nNoodl.Variables.readStep = i;\nif (kept) {\n  Noodl.Variables.readCard = kept.cardId;\n  Noodl.Variables.readUpsideDown = !!kept.reversed;\n  Noodl.Variables.readPhase = 'show';\n} else {\n  Noodl.Variables.readCard = '';\n  Noodl.Variables.readUpsideDown = false;\n  Noodl.Variables.readPhase = 'pick';\n}\n"},"ports":[],"children":[]},{"id":"rdPlace","type":"JavaScriptFunction","parameters":{"functionScript":