"parameters":{"name":"readPhase"},"ports":[],"children":[]},{"id":"rdVCard","type":"Variable2","parameters":{"name":"readCard"},"ports":[],"children":[]},{"id":"rdVUp","type":"Variable2","parameters":{"name":"readUpsideDown"},"ports":[],"children":[]},{"id":"rdVDrawn","type":"Variable2","parameters":{"name":"readDrawn"},"ports":[],"children":[]},{"id":"rdVTotal","type":"Variable2","parameters":{"name":"readTotal"},"ports":[],"children":[]},{"id":"rdPhase","type":"States","parameters":{"states":"pick,show,done","values":"x","useTransitions":false},"ports":[],"children":[]},{"id":"rdPos","type":"JavaScriptFunction","parameters":{"functionScript":"const spreads = Inputs.spreads || [];\nconst s = spreads.find(x => x.id === Inputs.spreadId) || spreads[0];\nif (!s) return;\nconst total = s.positions.length;\nconst step = Math.min(Inputs.step || 0, total - 1);\nconst p = s.positions[step];\nOutputs.spreadName = s.name;\nOutputs.posName = p.name;\nOutputs.posLead = p.lead;\nOutputs.total = total;\nOutputs.stepLabel = total > 1 ? 'Card ' + (step + 1) + ' of ' + total : '';\nOutputs.keepLabel = total === 1 ? 'Done' : (step + 1 >= total ? 'See the whole reading' : 'Next card');\n"},"ports":[{"name":"in-spreads","displayName":"spreads","plug":"input","type":"*","group":"Inputs","index":11},{"name":"in-spreadId","displayName":"spreadId","plug":"input","type":"*","group":"Inputs","index":12},{"name":"in-step","displayName":"step","plug":"input","type":"*","group":"Inputs","index":13},{"name":"out-spreadName","displayName":"spreadName","plug":"output","type":"*","group":"Outputs","index":14},{"name":"out-posName","displayName":"posName","plug":"output","type":"*","group":"Outputs","index":15},{"name":"out-posLead","displayName":"posLead","plug":"output","type":"*","group":"Outputs","index":16},{"name":"out-total","displayName":"total","plug":"output","type":"*","group":"Outputs","index":17},{"name":"out-stepLabel","displayName":"stepLabel","plug":"output","type":"*","group":"Outputs","index":18},{"name":"out-keepLabel","displayName":"keepLabel","plug":"output","type":"*","group":"Outputs","index":19}],"children":[]},{"id":"rdCard","type":"JavaScriptFunction","parameters":{"functionScript":"const c = (Inputs.cards || []).find(x => x.id === Inputs.cardId);\nif (!c) return;\nconst down = !!Inputs.upsideDown;\nOutputs.chip = c.chip;\nOutputs.name = c.name;\nOutputs.suitName = c.suit === 'major' ? 'Major Arcana' : c.suit.charAt(0).toUpperCase() + c.suit.slice(1);\nOutputs.keywords = c.keywords;\nOutputs.text = down ? c.rev : c.up;\nOutputs.ask = down ? c.askRev : c.askUp;\nOutputs.reversed = down;\n"},"ports":[{"name":"in-cards","displayName":"cards","plug":"input","type":"*","group":"Inputs","index":11},{"name":"in-cardId","displayName":"cardId","plug":"input","type":"*","group":"Inputs","index":12},{"name":"in-upsideDown","displayName":"upsideDown","plug":"input","type":"*","group":"Inputs","index":13},{"name":"out-chip","displayName":"chip","plug":"output","type":"*","group":"Outputs","index":14},{"name":"out-name","displayName":"name","plug":"output","type":"*","group":"Outputs","index":15},{"name":"out-suitName","displayName":"suitName","plug":"output","type":"*","group":"Outputs","index":16},{"name":"out-keywords","displayName":"keywords","plug":"output","type":"*","group":"Outputs","index":17},{"name":"out-text","displayName":"text","plug":"output","type":"*","group":"Outputs","index":18},{"name":"out-ask","displayName":"ask","plug":"output","type":"*","group":"Outputs","index":19},{"name":"out-reversed","displayName":"reversed","plug":"output","type":"*","group":"Outputs","index":20}],"children":[]},{"id":"rdFlipLook","type":"Expression","parameters":{"expression":"upsideDown ? 'down' : 'up'"},"ports":[],"children":[]},{"id":"rdFlipStates","type":"States","parameters":{"states":"up,down","values":"upBg,upInk,downBg,downInk","useTransitions":false,"type-upBg":"color","type-upInk":"color","type-downBg":"color","type-downInk":"color","value-