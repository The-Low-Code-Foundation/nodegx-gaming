os' + step, step: step, cardId: Noodl.Variables.readCard, reversed: !!Noodl.Variables.readUpsideDown });\nNoodl.Variables.readDrawn = drawn;\nif (step + 1 >= total) {\n  Noodl.Variables.readPhase = 'done';\n} else {\n  Noodl.Variables.readStep = step + 1;\n  Noodl.Variables.readCard = '';\n  Noodl.Variables.readPhase = 'pick';\n}\n"},"ports":[],"children":[]},{"id":"rdTopOfPage","type":"JavaScriptFunction","parameters":{"functionScript":"window.scrollTo(0, 0);\n"},"ports":[],"children":[]},{"id":"rdSummary","type":"JavaScriptFunction","parameters":{"functionScript":"const spreads = Inputs.spreads || [];\nconst s = spreads.find(x => x.id === Inputs.spreadId) || spreads[0];\nconst cards = Inputs.cards || [];\nOutputs.rows = (Inputs.drawn || []).map(d => {\n  const c = cards.find(x => x.id === d.cardId) || {};\n  const p = (s && s.positions[d.step]) || {};\n  return {\n    id: d.id,\n    position: p.name || '',\n    name: d.reversed ? c.name + ', upside down' : c.name,\n    keywords: c.keywords,\n    ask: d.reversed ? c.askRev : c.askUp\n  };\n});\n"},"ports":[{"name":"in-spreads","displayName":"spreads","plug":"input","type":"*","group":"Inputs","index":11},{"name":"in-spreadId","displayName":"spreadId","plug":"input","type":"*","group":"Inputs","index":12},{"name":"in-cards","displayName":"cards","plug":"input","type":"*","group":"Inputs","index":13},{"name":"in-drawn","displayName":"drawn","plug":"input","type":"*","group":"Inputs","index":14},{"name":"out-rows","displayName":"rows","plug":"output","type":"*","group":"Outputs","index":15}],"children":[]},{"id":"rdGoHome","type":"RouterNavigate","parameters":{"target":"/Pages/Home"},"ports":[],"children":[]}],"connections":[{"sourceId":"rdSpreads","sourcePort":"spreads","targetId":"rdPos","targetPort":"in-spreads"},{"sourceId":"rdVSpread","sourcePort":"value","targetId":"rdPos","targetPort":"in-spreadId"},{"sourceId":"rdVStep","sourcePort":"value","targetId":"rdPos","targetPort":"in-step"},{"sourceId":"rdPos","source