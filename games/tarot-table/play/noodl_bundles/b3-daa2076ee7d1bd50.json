-' + String(i).padStart(2, '0'));\nfor (const s of ['wands', 'cups', 'swords', 'pentacles'])\n  for (let i = 1; i <= 14; i++) ids.push(s + '-' + String(i).padStart(2, '0'));\nconst left = ids.filter(id => id !== Noodl.Variables.deckCard);\nNoodl.Variables.deckCard = left[Math.floor(Math.random() * left.length)];\n"},"ports":[],"children":[]},{"id":"dkTop","type":"JavaScriptFunction","parameters":{"functionScript":"window.scrollTo(0, 0);\n"},"ports":[],"children":[]},{"id":"dkGoHome","type":"RouterNavigate","parameters":{"target":"/Pages/Home"},"ports":[],"children":[]}],"connections":[{"sourceId":"dkCards","sourcePort":"cards","targetId":"dkCard","targetPort":"in-cards"},{"sourceId":"dkVCard","sourcePort":"value","targetId":"dkCard","targetPort":"in-cardId"},{"sourceId":"dkVCard","sourcePort":"value","targetId":"dkHas","targetPort":"card"},{"sourceId":"dkHas","sourcePort":"isTrue","targetId":"dkOne","targetPort":"mounted"},{"sourceId":"dkHas","sourcePort":"isFalse","targetId":"dkBrowse","targetPort":"mounted"},{"sourceId":"dkCard","sourcePort":"out-name","targetId":"dkFace","targetPort":"name"},{"sourceId":"dkCard","sourcePort":"out-keywords","targetId":"dkUp","targetPort":"keywords"},{"sourceId":"dkCard","sourcePort":"out-up","targetId":"dkUp","targetPort":"text"},{"sourceId":"dkCard","sourcePort":"out-askUp","targetId":"dkUp","targetPort":"ask"},{"sourceId":"dkCard","sourcePort":"out-rev","targetId":"dkDown","targetPort":"text"},{"sourceId":"dkCard","sourcePort":"out-askRev","targetId":"dkDown","targetPort":"ask"},{"sourceId":"dkPicker","sourcePort":"cardId","targetId":"dkSetCard","targetPort":"value"},{"sourceId":"dkPicker","sourcePort":"picked","targetId":"dkSetCard","targetPort":"do"},{"sourceId":"dkPicker","sourcePort":"picked","targetId":"dkTop","targetPort":"run"},{"sourceId":"dkRandomBtn","sourcePort":"onClick","targetId":"dkRandom","targetPort":"run"},{"sourceId":"dkRandomBtn","sourcePort":"onClick","targetId":"dkTop","targetPort":"run"},{"sourceId":"dkAno