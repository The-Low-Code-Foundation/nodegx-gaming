{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "95f39c1b-997b-5d0c-8344-14c4595f59f2",
  "version": 1,
  "nodes": [
    {
      "id": "fcIn",
      "type": "Component Inputs",
      "x": 520,
      "y": 40,
      "ports": [
        {
          "name": "src",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "name",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "reversed",
          "plug": "output",
          "type": "boolean"
        }
      ]
    },
    {
      "id": "fcWay",
      "type": "Expression",
      "label": "Which way up",
      "x": 520,
      "y": 220,
      "parameters": {
        "expression": "reversed ? 'down' : 'up'"
      }
    },
    {
      "id": "fcTurn",
      "type": "States",
      "label": "Turn the card",
      "x": 520,
      "y": 340,
      "parameters": {
        "states": "up,down",
        "values": "turn",
        "useTransitions": true,
        "type-turn": "number",
        "value-up-turn": 0,
        "value-down-turn": 180
      }
    },
    {
      "id": "fcWrap",
      "type": "Group",
      "label": "Centre the card",
      "x": 40,
      "y": 40,
      "children": [
        "fcCard"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "column",
        "alignItems": "center",
        "paddingTop": "var(--space-2)",
        "paddingBottom": "var(--space-2)"
      }
    },
    {
      "id": "fcCard",
      "type": "Group",
      "label": "Card",
      "x": 60,
      "y": 140,
      "parent": "fcWrap",
      "parameters": {
        "sizeMode": "explicit",
        "width": {
          "value": 190,
          "unit": "px"
        },
        "height": {
          "value": 326,
          "unit": "px"
        },
        "flexDirection": "column",
        "borderRadius": "var(--radius-lg)",
        "boxShadowEnabled": true,
        "boxShadowOffsetY": {
          "value": 10,
          "unit": "px"
        },
        "boxShadowBlurRadius": {
          "value": 30,
          "unit": "px"
        },
        "boxShadowColor": "var(--muted)",
        "backgroundColor": "var(--background)"
      },
      "children": [
        "fcPic"
      ]
    },
    {
      "id": "fcPic",
      "type": "Image",
      "label": "The card's picture",
      "x": 80,
      "y": 220,
      "parent": "fcCard",
      "parameters": {
        "sizeMode": "explicit",
        "width": {
          "value": 100,
          "unit": "%"
        },
        "height": {
          "value": 100,
          "unit": "%"
        },
        "objectFit": "fill"
      },
      "metadata": {
        "comment": "The pictures are project/cards/<card id>.svg, drawn by tools/draw-cards.mjs. Swap any file for your own picture under the same name."
      }
    }
  ],
  "visualRoots": [
    "fcWrap"
  ]
}