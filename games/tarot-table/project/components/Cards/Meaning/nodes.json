      "label": "Is the deeper look open?",
      "x": 820,
      "y": 40,
      "metadata": {
        "comment": "Per instance, so it stays open from one card to the next once someone has opened it."
      }
    },
    {
      "id": "mnHasMore",
      "type": "Expression",
      "label": "Is there more to show?",
      "x": 820,
      "y": 160,
      "parameters": {
        "expression": "!!(more && more.length)"
      }
    },
    {
      "id": "mnShowMore",
      "type": "Expression",
      "label": "Show the deeper look?",
      "x": 820,
      "y": 260,
      "parameters": {
        "expression": "!!(open && more && more.length)"
      }
    },
    {
      "id": "mnMoreLabel",
      "type": "Expression",
      "label": "Open or close",
      "x": 820,
      "y": 360,
      "parameters": {
        "expression": "open ? 'Less about this card  ▴' : 'More about this card  ▾'"
      }
    }
