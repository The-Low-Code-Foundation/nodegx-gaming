    {
      "id": "rdDraw",
      "type": "JavaScriptFunction",
      "label": "Draw one for me",
      "x": 1600,
      "y": 200,
      "parameters": {
        "functionScript": "const ids = [];\nfor (let i = 0; i < 22; i++) ids.push('major-' + String(i).padStart(2, '0'));\nfor (const s of ['wands', 'cups', 'swords', 'pentacles'])\n  for (let i = 1; i <= 14; i++) ids.push(s + '-' + String(i).padStart(2, '0'));\nconst used = (Noodl.Variables.readDrawn || []).map(d => d.cardId);\nconst left = ids.filter(id => used.indexOf(id) < 0);\nNoodl.Variables.readCard = left[Math.floor(Math.random() * left.length)];\nNoodl.Variables.readUpsideDown = Math.random() < 0.5;\nNoodl.Variables.readPhase = 'show';\n"
      },
      "metadata": {
        "comment": "Picks at random from the cards not yet on the table, upside down half the time, as a shuffled deck would."
      }
    },
    {
      "id": "rdKeep",
      "type": "JavaScriptFunction",
      "label": "Keep this card and move on",
      "x": 1600,
      "y": 360,
      "parameters": {
        "functionScript": "const step = Noodl.Variables.readStep || 0;\nconst total = Noodl.Variables.readTotal || 1;\nconst drawn = (Noodl.Variables.readDrawn || []).slice();\ndrawn.push({ id: 'pos' + step, step: step, cardId: Noodl.Variables.readCard, reversed: !!Noodl.Variables.readUpsideDown });\nNoodl.Variables.readDrawn = drawn;\nif (step + 1 >= total) {\n  Noodl.Variables.readPhase = 'done';\n} else {\n  Noodl.Variables.readStep = step + 1;\n  Noodl.Variables.readCard = '';\n  Noodl.Variables.readPhase = 'pick';\n}\n"
      }
    },
    {
      "id": "rdTopOfPage",
      "type": "JavaScriptFunction",
      "label": "Back to the top of the page",
      "x": 1600,
      "y": 520,
      "parameters": {
        "functionScript": "window.scrollTo(0, 0);\n"
      },
      "metadata": {
        "comment": "Each step replaces the screen, so start it at the top rather than where the last one was scrolled to."
      }
    },
    {
      "id": "rdSummary",
      "type": "JavaScriptFunction",
      "label": "The summary rows",
      "x": 1000,
      "y": 1000,
      "parameters": {
        "functionScript": "const spreads = Inputs.spreads || [];\nconst s = spreads.find(x => x.id === Inputs.spreadId) || spreads[0];\nconst cards = Inputs.cards || [];\nOutputs.rows = (Inputs.drawn || []).map(d => {\n  const c = cards.find(x => x.id === d.cardId) || {};\n  const p = (s && s.positions[d.step]) || {};\n  return {\n    id: d.id,\n    position: p.name || '',\n    name: d.reversed ? c.name + ', upside down' : c.name,\n    keywords: c.keywords,\n    ask: d.reversed ? c.askRev : c.askUp\n  };\n});\n"
      },
      "ports": [
        {
          "name": "in-spreads",
          "displayName": "spreads",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
