    {
      "id": "rdPos",
      "type": "JavaScriptFunction",
      "label": "Where we are in the spread",
      "x": 1000,
      "y": 40,
      "parameters": {
        "functionScript": "const spreads = Inputs.spreads || [];\nconst s = spreads.find(x => x.id === Inputs.spreadId) || spreads[0];\nif (!s) return;\nconst total = s.positions.length;\nconst step = Math.min(Inputs.step || 0, total - 1);\nconst p = s.positions[step];\nOutputs.spreadName = s.name;\nOutputs.posName = p.name;\nOutputs.posLead = p.lead;\nOutputs.total = total;\nOutputs.stepLabel = total > 1 ? 'Card ' + (step + 1) + ' of ' + total : '';\nOutputs.keepLabel = total === 1 ? 'Done' : (step + 1 >= total ? 'See the whole reading' : 'Next card');\n"
      },
      "metadata": {
        "comment": "With no spread chosen (the page opened directly) it falls back to the first spread."
      },
      "ports": [
        {
          "name": "in-spreads",
          "displayName": "spreads",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-spreadId",
          "displayName": "spreadId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-step",
          "displayName": "step",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-spreadName",
          "displayName": "spreadName",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-posName",
