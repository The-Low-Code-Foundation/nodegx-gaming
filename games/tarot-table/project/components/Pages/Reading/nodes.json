    {
      "id": "rdGoTo",
      "type": "JavaScriptFunction",
      "label": "Go to the tapped place",
      "x": 1600,
      "y": 1520,
      "parameters": {
        "functionScript": "const i = Noodl.Variables.readTapped || 0;\nconst kept = (Noodl.Variables.readDrawn || []).find(d => d.step === i);\nNoodl.Variables.readStep = i;\nif (kept) {\n  Noodl.Variables.readCard = kept.cardId;\n  Noodl.Variables.readUpsideDown = !!kept.reversed;\n  Noodl.Variables.readPhase = 'show';\n} else {\n  Noodl.Variables.readCard = '';\n  Noodl.Variables.readUpsideDown = false;\n  Noodl.Variables.readPhase = 'pick';\n}\n"
      },
      "metadata": {
        "comment": "A place with a card kept in it opens that card again; an empty one asks for its card. Cards can go down in any order."
      }
    }
