    {
      "id": "rdSummary",
      "type": "JavaScriptFunction",
      "label": "The summary rows",
      "x": 1000,
      "y": 1000,
      "parameters": {
        "functionScript": "const spreads = Inputs.spreads || [];\nconst s = spreads.find(x => x.id === Inputs.spreadId) || spreads[0];\nconst cards = Inputs.cards || [];\nOutputs.rows = (Inputs.drawn || []).slice().sort((a, b) => a.step - b.step).map(d => {\n  const c = cards.find(x => x.id === d.cardId) || {};\n  const p = (s && s.positions[d.step]) || {};\n  return {\n    id: d.id,\n    position: (d.step + 1) + '. ' + (p.name || ''),\n    name: d.reversed ? c.name + ', upside down' : c.name,\n    src: 'cards/' + d.cardId + '.svg',\n    turn: d.reversed ? 180 : 0,\n    keywords: c.keywords,\n    ask: d.reversed ? c.askRev : c.askUp\n  };\n});\n"
      },
      "ports": [
        {
          "name": "in-spreads",
