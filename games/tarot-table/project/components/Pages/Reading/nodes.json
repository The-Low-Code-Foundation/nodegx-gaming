    {
      "id": "rdPos",
      "type": "JavaScriptFunction",
      "label": "Where we are in the spread",
      "x": 1000,
      "y": 40,
      "parameters": {
        "functionScript": "const spreads = Inputs.spreads || [];\nconst s = spreads.find(x => x.id === Inputs.spreadId) || spreads[0];\nif (!s) return;\nconst total = s.positions.length;\nconst step = Math.min(Inputs.step || 0, total - 1);\nconst p = s.positions[step];\nconst drawn = Inputs.drawn || [];\nconst othersLeft = s.positions.some((q, i) => i !== step && !drawn.some(d => d.step === i));\nOutputs.spreadName = s.name;\nOutputs.posName = p.name;\nOutputs.posLead = p.lead;\nOutputs.total = total;\nOutputs.stepLabel = total > 1 && Inputs.phase !== 'done' ? 'Card ' + (step + 1) + ' of ' + total : '';\nOutputs.keepLabel = total === 1 ? 'Done' : (othersLeft ? 'Next card' : 'See the whole reading');\n"
      },
      "metadata": {
        "comment": "With no spread chosen (the page opened directly) it falls back to the first spread."
      },
      "ports": [
        {
          "name": "in-spreads",
          "displayName": "spreads",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
