    {
      "id": "rdDraw",
      "type": "JavaScriptFunction",
      "label": "Draw one for me",
      "x": 1600,
      "y": 200,
      "parameters": {
        "functionScript": "const ids = [];\nfor (let i = 0; i < 22; i++) ids.push('major-' + String(i).padStart(2, '0'));\nfor (const s of ['wands', 'cups', 'swords', 'pentacles'])\n  for (let i = 1; i <= 14; i++) ids.push(s + '-' + String(i).padStart(2, '0'));\nconst step = Noodl.Variables.readStep || 0;\nconst used = (Noodl.Variables.readDrawn || []).filter(d => d.step !== step).map(d => d.cardId);\nconst left = ids.filter(id => used.indexOf(id) < 0);\nNoodl.Variables.readCard = left[Math.floor(Math.random() * left.length)];\nNoodl.Variables.readUpsideDown = Math.random() < 0.5;\nNoodl.Variables.readPhase = 'show';\n"
      },
      "metadata": {
        "comment": "Picks at random from the cards not yet on the table, upside down half the time, as a shuffled deck would."
      }
    },
    {
      "id": "rdKeep",
      "type": "JavaScriptFunction",
      "label": "Keep this card and move on",
      "x": 1600,
      "y": 360,
      "parameters": {
        "functionScript": "// A second tap on the button (a double tap on a phone) arrives after the card was already kept: nothing to keep.\nif (!Noodl.Variables.readCard || Noodl.Variables.readPhase !== 'show') return;\nconst step = Noodl.Variables.readStep || 0;\nconst total = Noodl.Variables.readTotal || 1;\nconst drawn = (Noodl.Variables.readDrawn || []).filter(d => d.step !== step);\ndrawn.push({ id: 'pos' + step, step: step, cardId: Noodl.Variables.readCard, reversed: !!Noodl.Variables.readUpsideDown });\ndrawn.sort((a, b) => a.step - b.step);\nNoodl.Variables.readDrawn = drawn;\n// The next empty place after this one, going round; none left means the reading is complete.\nlet next = -1;\nfor (let k = 1; k <= total; k++) {\n  const j = (step + k) % total;\n  if (!drawn.some(d => d.step === j)) { next = j; break; }\n}\nif (next < 0) {\n  Noodl.Variables.readPhase = 'done';\n} else {\n  Noodl.Variables.readStep = next;\n  Noodl.Variables.readCard = '';\n  Noodl.Variables.readUpsideDown = false;\n  Noodl.Variables.readPhase = 'pick';\n}\n"
      }
    },
    {
      "id": "rdTopOfPage",
