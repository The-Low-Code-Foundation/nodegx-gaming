    {
      "id": "rdCard",
      "type": "JavaScriptFunction",
      "label": "The card on the table, right way up or upside down",
      "x": 1000,
      "y": 480,
      "parameters": {
        "functionScript": "const c = (Inputs.cards || []).find(x => x.id === Inputs.cardId);\nif (!c) return;\nconst down = !!Inputs.upsideDown;\nOutputs.src = 'cards/' + c.id + '.svg';\nOutputs.name = c.name;\nOutputs.keywords = c.keywords;\nOutputs.text = down ? c.rev : c.up;\nOutputs.ask = down ? c.askRev : c.askUp;\nOutputs.reversed = down;\n"
      },
      "ports": [
        {
          "name": "in-cards",
          "displayName": "cards",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
