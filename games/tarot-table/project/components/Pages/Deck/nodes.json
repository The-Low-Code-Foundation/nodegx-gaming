    {
      "id": "dkCard",
      "type": "JavaScriptFunction",
      "label": "The card being looked at",
      "x": 1000,
      "y": 40,
      "parameters": {
        "functionScript": "const c = (Inputs.cards || []).find(x => x.id === Inputs.cardId);\nif (!c) return;\nOutputs.src = 'cards/' + c.id + '.svg';\nOutputs.name = c.name;\nOutputs.keywords = c.keywords;\nOutputs.up = c.up;\nOutputs.askUp = c.askUp;\nOutputs.rev = c.rev;\nOutputs.askRev = c.askRev;\n"
      },
      "ports": [
        {
          "name": "in-cards",
          "displayName": "cards",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-cardId",
          "displayName": "cardId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
