    {
      "id": "dkRandom",
      "type": "JavaScriptFunction",
      "label": "Open a random card",
      "x": 1000,
      "y": 560,
      "parameters": {
        "functionScript": "const ids = [];\nfor (let i = 0; i < 22; i++) ids.push('major-' + String(i).padStart(2, '0'));\nfor (const s of ['wands', 'cups', 'swords', 'pentacles'])\n  for (let i = 1; i <= 14; i++) ids.push(s + '-' + String(i).padStart(2, '0'));\nconst left = ids.filter(id => id !== Noodl.Variables.deckCard);\nNoodl.Variables.deckCard = left[Math.floor(Math.random() * left.length)];\n"
      }
    },
