{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "5ce7db7b-ed10-5de4-8611-c3915368228e",
  "version": 1,
  "nodes": [
    {
      "id": "scIn",
      "type": "Component Inputs",
      "x": 460,
      "y": 40,
      "ports": [
        {
          "name": "id",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "name",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "count",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "blurb",
          "plug": "output",
          "type": "string"
        }
      ]
    },
    {
